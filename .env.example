# Discord Bot — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ─────────────────────────────────────────────
# Discord
# ─────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=your_discord_guild_id_here   # Used only during dev for instant slash-command sync

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────
# Express (Render requires a bound PORT)
# ─────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────
# Channel IDs  (right-click channel > Copy ID)
# ─────────────────────────────────────────────
WELCOME_CHANNEL_ID=
MOD_LOGS_CHANNEL_ID=
SERVER_LOGS_CHANNEL_ID=
ROLES_CHANNEL_ID=
SOCIAL_NOTIF_CHANNEL_ID=

# ─────────────────────────────────────────────
# Role IDs  (right-click role > Copy ID)
# ─────────────────────────────────────────────
DEFAULT_MEMBER_ROLE_ID=

# ─────────────────────────────────────────────
# Social RSS feeds  (leave blank to disable)
# ─────────────────────────────────────────────
YOUTUBE_RSS_URL=https://www.youtube.com/feeds/videos.xml?channel_id=YOUR_CHANNEL_ID
FACEBOOK_RSS_URL=
INSTAGRAM_RSS_URL=
TIKTOK_RSS_URL=

# Optional: ping @everyone or @here on social posts (true/false)
SOCIAL_PING_EVERYONE=false
